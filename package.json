{
  "name": "@antlur/backstage",
  "author": "Anthony Holmes",
  "version": "1.16.1",
  "description": "A simple client for Backstage CMS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antlur/backstage-npm.git"
  },
  "keywords": [
    "cms",
    "backstage",
    "headless-cms",
    "content-management",
    "api-client",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "pack:release": "npm test && npm pack --ignore-scripts",
    "publish:release": "npm test && npm publish --ignore-scripts",
    "dev": "tsc --watch",
    "cli": "jiti src/cli/cli.ts",
    "postbuild": "chmod +x ./dist/cli/cli.js",
    "test": "npm run build && tsc --noEmit --strict --skipLibCheck --target ESNext --module ESNext --moduleResolution bundler tests/public-api.type-test.ts && node --test dist/endpoints/alerts.test.js dist/endpoints/frontstage.test.js dist/endpoints/routes.test.js dist/endpoints/website.test.js tests/frontstage-client.test.js tests/block-manifests.test.js tests/package-exports.test.js"
  },
  "bin": {
    "backstage": "./dist/cli/cli.js"
  },
  "peerDependencies": {
    "luxon": "^3.5.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "jiti": "^2.4.2",
    "schema-dts": "^1.1.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "luxon": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "src",
    "readme.md"
  ]
}
